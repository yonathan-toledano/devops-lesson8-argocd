apiVersion: v1
kind: Namespace
metadata:
  name: student-apps
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: my-website-config
  namespace: student-apps
data:
  index.html: |
    <!DOCTYPE html>
    <html>
    <head>
      <title>GitOps Demo</title>
    </head>
    <body style="background-color: #2d3436; color: white; text-align: center; padding-top: 50px;">
      <h1>eli you the best</h1>
      <p>Deployed via ArgoCD</p>
    </body>
    </html>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-website
  namespace: student-apps
spec:
  replicas: 1
  selector:
    matchLabels:
      app: my-website
  template:
    metadata:
      labels:
        app: my-website
    spec:
      containers:
        - name: nginx
          image: nginx:latest
          ports:
            - containerPort: 80
          volumeMounts:
            - name: website-content
              mountPath: /usr/share/nginx/html/index.html
              subPath: index.html
      volumes:
        - name: website-content
          configMap:
            name: my-website-config
---
apiVersion: v1
kind: Service
metadata:
  name: my-website-service
  namespace: student-apps
spec:
  type: NodePort
  selector:
    app: my-website
  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
      nodePort: 30084
